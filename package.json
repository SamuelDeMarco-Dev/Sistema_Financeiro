{
  "name": "gerenciador-de-financas",
  "private": true,
  "version": "1.1.0",
  "description": "Gerenciador de Finanças (PFM) — plataforma web de gestão financeira pessoal e compartilhada.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev --workspace=backend --if-present\" \"npm run dev --workspace=frontend --if-present\"",
    "build": "npm run build --workspaces --if-present",
    "verificar": "npm run verificar --workspace=backend --if-present && npm run verificar --workspace=frontend --if-present",
    "tipos": "npm run tipos --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "formatar": "prettier --ignore-path .prettierignore --write \"**/*.md\" \"*.{json,cjs,js}\" && npm run formatar --workspaces --if-present",
    "formatar:check": "prettier --ignore-path .prettierignore --check \"**/*.md\" \"*.{json,cjs,js}\" && npm run formatar:check --workspaces --if-present",
    "teste:unitario": "npm run teste:unitario --workspaces --if-present",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "concurrently": "^9.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1"
  },
  "overrides": {
    "@types/express": "^4.17.21",
    "@types/express-serve-static-core": "^4.19.9"
  }
}
