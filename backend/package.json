{
  "name": "backend",
  "private": true,
  "version": "1.0.0",
  "description": "Gerenciador de Finanças (PFM) — API backend.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "tipos": "tsc --noEmit",
    "teste": "vitest run",
    "teste:observar": "vitest",
    "teste:unitario": "vitest run testes/unitarios",
    "teste:integracao": "vitest run testes/integracao",
    "teste:cobertura": "vitest run --coverage",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^4.1.10",
    "prisma": "^6.19.3",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10",
    "vitest-mock-extended": "^5.1.0"
  }
}
